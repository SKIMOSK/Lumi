<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- MAIN CHAT UI -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Hidden toolbar kept so setSupportActionBar still works for menus -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"/>

        <!-- Visual header: dark navy + rounded bottom corners -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/appbar_bg"
            android:orientation="vertical"
            android:paddingBottom="14dp"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:paddingTop="10dp">

                <!-- LumiGlyph avatar -->
                <View
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/lumi_glyph_bg"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lumi"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvBtStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Deconectat"
                        android:textColor="#B3FFFFFF"
                        android:textSize="11sp"
                        android:layout_marginTop="1dp"/>

                </LinearLayout>

                <Button
                    android:id="@+id/btnConnect"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minHeight="0dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Conectare"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp"
                    android:layout_marginEnd="2dp"/>

                <ImageButton
                    android:id="@+id/btnHeaderSettings"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/icon_btn_dark_bg"
                    android:src="@android:drawable/ic_menu_preferences"
                    android:contentDescription="Setari"
                    android:tint="#FFFFFF"
                    android:layout_marginStart="4dp"/>

            </LinearLayout>
        </LinearLayout>

        <!-- Status chips strip -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_main"
            android:scrollbars="none"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/chipBt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip_default"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="Deconectat"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvNotifStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip_default"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginStart="8dp"
                    android:text="Notificari OFF"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/chipMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip_accent"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginStart="8dp"
                    android:text="Mod Actiune"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Thin progress bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="true"
            android:visibility="gone"
            android:indeterminateTint="@color/accent"/>

        <!-- Status text (shown during processing) -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_main"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Inactiv"
            android:textColor="@color/text_hint"
            android:textSize="11sp"
            android:visibility="gone"/>

        <!-- Conversation list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMessages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/bg_main"
            android:clipToPadding="false"
            android:paddingTop="10dp"
            android:paddingBottom="8dp"
            android:scrollbars="none"/>

        <!-- Input bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp">

            <ImageButton
                android:id="@+id/btnAttach"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_input_add"
                android:contentDescription="Ataseaza"
                android:tint="@color/text_secondary"/>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="8dp">

                <EditText
                    android:id="@+id/etInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/input_pill_bg"
                    android:hint="Scrie sau vorbeste..."
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="4"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="14sp"/>

                <ImageView
                    android:id="@+id/ivAttachedPreview"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="Previzualizare"
                    android:scaleType="centerCrop"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvAttachedFile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/chip_default"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:maxWidth="130dp"
                    android:ellipsize="start"
                    android:singleLine="true"
                    android:visibility="gone"/>

            </FrameLayout>

            <!-- Send icon: visible when text is typed -->
            <ImageButton
                android:id="@+id/btnSend"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_send"
                android:contentDescription="Trimite"
                android:tint="@color/accent"
                android:visibility="gone"/>

            <!-- Mic FAB — main action -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabMic"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@android:drawable/ic_btn_speak_now"
                android:contentDescription="Microfon"
                app:backgroundTint="@color/accent"
                app:fabSize="mini"
                app:tint="@color/white"
                app:elevation="6dp"/>

        </LinearLayout>
    </LinearLayout>

    <!-- Stop FAB — shown while processing or in translation mode -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabStop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="90dp"
        android:src="@android:drawable/ic_media_pause"
        android:contentDescription="Opreste"
        android:visibility="gone"
        app:backgroundTint="#E53935"
        app:tint="@color/white"
        app:fabSize="normal"
        app:elevation="10dp"/>

    <!-- Translation mode banner -->
    <LinearLayout
        android:id="@+id/bannerTranslation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="80dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/chip_accent"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:id="@+id/tvTranslationBanner"
            android:text="Mod traducere activ — vorbeste"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- VOICE OVERLAY (shown while listening) -->
    <FrameLayout
        android:id="@+id/voiceOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F7F6FB"
        android:visibility="gone">

        <!-- Soft purple tint behind the orb -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#22B388FF"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Voice header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="10dp">

                <ImageButton
                    android:id="@+id/btnVoiceClose"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/chip_default"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:contentDescription="Inchide"
                    android:tint="@color/text_primary"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvVoiceStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ascult"
                        android:textColor="@color/accent"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.09"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Romana"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="1dp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Orb area -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center">

                <View
                    android:id="@+id/voiceRing2"
                    android:layout_width="260dp"
                    android:layout_height="260dp"
                    android:layout_gravity="center"
                    android:background="@drawable/voice_orb_ring"
                    android:alpha="0.18"/>

                <View
                    android:id="@+id/voiceRing1"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center"
                    android:background="@drawable/voice_orb_ring"
                    android:alpha="0.35"/>

                <View
                    android:id="@+id/voiceOrb"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center"
                    android:background="@drawable/voice_orb_bg"
                    android:elevation="8dp"/>

            </FrameLayout>

            <!-- Live transcript -->
            <TextView
                android:id="@+id/tvVoiceTranscript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingBottom="6dp"
                android:text="Asculta..."
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="transcrie in timp real"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:paddingBottom="20dp"/>

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <Button
                    android:id="@+id/btnVoiceCancel"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="Anuleaza"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    app:strokeColor="@color/line"
                    app:cornerRadius="26dp"/>

                <Button
                    android:id="@+id/btnVoiceSend"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="2"
                    android:layout_marginStart="10dp"
                    android:text="Trimite la Lumi"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/accent"
                    app:cornerRadius="26dp"
                    app:elevation="8dp"/>

            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
